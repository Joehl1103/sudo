{
  "scopeName": "source.workflow-experiment",
  "patterns": [
    { "name": "comment.line.number-sign.workflow", "match": "^\\s*#.*$" },
    { "name": "keyword.control.workflow", "match": "(?i)^\\s*(FOR\\s+EACH|WORKFLOW|USING|WHERE|DO|THEN|IF|ELSE|NOTE|STOP)(?=\\s|:|$)" },
    { "name": "markup.underline.link.workflow", "match": "https?://[^\\s]+" },
    { "name": "string.quoted.double.workflow", "begin": "\"", "end": "\"", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.workflow" }] },
    { "name": "keyword.operator.workflow", "match": "===|==|!=|(?i:\\b(?:AND|OR|NOT|IN)\\b)" }
  ]
}
